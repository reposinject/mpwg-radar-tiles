[Unit]
Description=MPWG NOAA MRMS radar tile cooker (one shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mpwg
Group=mpwg
WorkingDirectory=/opt/mpwg-radar
EnvironmentFile=-/etc/mpwg-radar.env
ExecStart=/opt/mpwg-radar/.venv/bin/mpwg-radar cook
Nice=10
# Prefer composite if a RALA cook is running on the same t4g.small.
# Default CPUWeight is 100; set it so the priority is explicit next to RALA.
CPUWeight=100
OOMScoreAdjust=-150
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# t4g.small is 2 GB; abort if the OS is thrashing instead of cooking forever.
# CONUS z6–8 upload of ~800–1000 objects can run several minutes on top of
# the cook. MPWG_UPLOAD_TIMEOUT default is 900s; this must outlive cook+upload.
# The 3 min timer waits; it does not cap this unit.
MemoryMax=1536M
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mpwg-radar

[Install]
WantedBy=multi-user.target
