[Unit]
Description=MPWG NOAA MRMS RALA tile cooker (parallel oneshot; not the default product)
After=network-online.target
Wants=network-online.target
# Do not Conflicts= mpwg-radar-cooker.service. Conflicts stops whichever unit
# starts second, so a 3-minute composite timer killed in-flight RALA cooks
# and a RALA start aborted composite. Tile trees are separate (rala/ vs
# clean/); manifest.json is merged under an flock. Composite keeps CPU and
# OOM priority so a parallel RALA cook yields first.

[Service]
Type=oneshot
User=mpwg
Group=mpwg
WorkingDirectory=/opt/mpwg-radar
EnvironmentFile=-/etc/mpwg-radar.env
# Force RALA endpoints even if /etc/mpwg-radar.env still has the composite URL.
# MPWG_PRODUCT in the env file stays composite; this Environment= line wins
# for this unit only and does not change the composite timer.
# Environment= after EnvironmentFile wins, so a host MPWG_UPLOAD_CONCURRENCY=2
# cannot throttle this unit. RALA ignores that shared knob unless
# MPWG_RALA_UPLOAD_CONCURRENCY is set; pin 8 here anyway.
Environment=MPWG_PRODUCT=rala
Environment=MPWG_RALA_UPLOAD_CONCURRENCY=8
ExecStart=/bin/bash -c 'unset MRMS_LATEST_URL MRMS_S3_PREFIX; exec /opt/mpwg-radar/.venv/bin/mpwg-radar cook --product rala'
Nice=14
CPUWeight=60
OOMScoreAdjust=300
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# One RALA invocation may cook several real scans missed while the previous
# cook was running (S3 catch-up). MPWG_RALA_CATCHUP_BUDGET_SECONDS defaults
# to 2700s of new frames, and MPWG_UPLOAD_TIMEOUT allows 900s for the last
# upload. 4200s covers that without SIGTERM mid-PUT. Composite stays at 1800s.
# MemoryMax matches composite; if the 2 GB host is exhausted the OOM score
# above kills this unit before the composite one.
MemoryMax=1536M
TimeoutStartSec=4200
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mpwg-radar-rala

[Install]
WantedBy=multi-user.target
