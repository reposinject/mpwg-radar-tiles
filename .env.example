# Copy to /etc/mpwg-radar.env on the EC2 host (or .env for local runs).
# Never commit real credentials.

# --- cooker region / zoom ---
# Named regions: conus (default, NOAA MRMS mosaic) or central-texas (smoke/dev).
# Aliases: REGION, BBOX (same meaning as MPWG_REGION / MPWG_BBOX).
MPWG_REGION=conus
# Optional override: west,south,east,north in degrees (replaces the named bbox).
# MPWG_BBOX=-130,20,-60,55
#
# CONUS candidate 512px XYZ tiles/frame (inclusive of empty tiles):
#   z5=35  z6=126  z7=442  z8=1734  z9=6600
# Default z6-8 = 2302 tiles/frame — fits t4g.small on the ~3 min timer with
# empty-tile skip. Do not set MPWG_MAX_ZOOM=9 on t4g.small (z6-9 = 8902).
# z5 is cheap (+35 tiles) if the map needs a national overview: MPWG_MIN_ZOOM=5.
MPWG_MODES=clean
# MPWG_MODES=clean,standard,all
MPWG_MIN_ZOOM=6
MPWG_MAX_ZOOM=8
MPWG_TILE_SIZE=512
MPWG_SKIP_EMPTY_TILES=true
MPWG_KEEP_DBZ=true
MPWG_DATA_DIR=/var/lib/mpwg-radar/data
MPWG_OUTPUT_DIR=/var/lib/mpwg-radar/output
MPWG_RETENTION_FRAMES=30
# RALA rolling archive only (composite ignores these). Age is the limit:
# 75 minutes holds a full 60-minute loop (~30 frames at a 2-minute cadence,
# ~37–38 in the whole window). The frame cap is a ceiling above that count,
# not a thinner. A low MPWG_RETENTION_FRAMES does not apply to RALA.
# MPWG_RALA_RETENTION_MINUTES=75
# MPWG_RALA_RETENTION_FRAMES=60
# Stop starting more catch-up frames after this many seconds (default 2700).
# MPWG_RALA_CATCHUP_BUDGET_SECONDS=2700
# RALA upload workers. Default 8. MPWG_UPLOAD_CONCURRENCY does not apply.
# MPWG_RALA_UPLOAD_CONCURRENCY=8
# RALA tile threads. Default 2 (t4g.small). The RALA unit pins this.
# Composite stays at 1 unless you set it here.
# MPWG_TILE_WORKERS=2
MPWG_LOG_LEVEL=INFO

# Product for a manual `mpwg-radar cook` with no --product flag.
# Keep this composite. The composite timer reads it. The RALA timer unit sets
# MPWG_PRODUCT=rala for that process only and must not change this line.
# RALA runs on mpwg-radar-cooker-rala.timer (about every 2 minutes) in parallel
# with composite. Do not set this to rala.
MPWG_PRODUCT=composite
# Optional display cutoff override (composite Clean JSON is 15; rala JSON is 0).
# MPWG_DISPLAY_MIN_DBZ=0
# Optional palette override. Defaults: composite → mpwg-clean-2026-09,
# rala → mpwg-rala-2026-09.
# MPWG_PALETTE=mpwg-clean-2026-09

# R2 upload: each cook sends only the new frame + latest pointers + manifest
# (not the full retention tree). Defaults are sized for t4g.small CONUS.
# At concurrency=2 this host does a few objects/sec; a typical frame is
# ~800–1000 objects (RALA oneshot ~866 objects, ~230s). 180s left failed
# uploads every cycle — leave the 900s default unless you measured faster.
# MPWG_UPLOAD_CONCURRENCY=2
# MPWG_UPLOAD_CONNECT_TIMEOUT=10
# MPWG_UPLOAD_READ_TIMEOUT=30
# MPWG_UPLOAD_OBJECT_TIMEOUT=60
# MPWG_UPLOAD_TIMEOUT=900
# MPWG_UPLOAD_MAX_ATTEMPTS=2

# NOAA MRMS (self-hosted ingest; no paid radar vendor)
# Endpoints follow MPWG_PRODUCT. Leave these commented unless you need a
# composite-era override. A leftover composite URL is ignored when cooking rala.
# MRMS_LATEST_URL=https://mrms.ncep.noaa.gov/2D/MergedReflectivityQCComposite/MRMS_MergedReflectivityQCComposite.latest.grib2.gz
# MRMS_S3_PREFIX=CONUS/MergedReflectivityQCComposite_00.50
MRMS_S3_BUCKET=noaa-mrms-pds
MRMS_TIMEOUT_SECONDS=60

# --- Cloudflare R2 (S3-compatible). Leave blank to cook locally without upload. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mpwg-radar
R2_ENDPOINT=
# If R2_ENDPOINT is empty, it is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PREFIX=radar
R2_PUBLIC_BASE_URL=
MPWG_UPLOAD=true
