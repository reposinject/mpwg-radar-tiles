{
  "id": "mpwg-rala-2026-09",
  "name": "MPWG RALA",
  "author": "James",
  "version": "2026-09-rala-p2b",
  "description": "RALA display ramp biased to the 2026-09-21 RadarScope side-by-side. RGB and alpha are interpolated continuously against actual dBZ (not nearest 5 dBZ steps). Greens are brighter than the olive #08772E Clean anchor; James #0FA33D and #32C94B remain, then a neon lift into yellow. James hexes from yellow upward are kept, but orange is stretched and magenta starts at 60 so cores are not a long dark-red plateau. Below 15, faint greens stay visible and alpha ramps down so weak returns are wisps, not opaque dark blocks. No-echo and missing stay alpha 0 via the category mask. There is no hard <15 cutoff. Composite keeps mpwg-clean-2026-09.",
  "units": "dBZ",
  "display_min_dbz": -32,
  "below_min": [0, 0, 0, 0],
  "stops": [
    {"dbz": -32, "hex": "#8CFF82", "rgba": [140, 255, 130, 48], "label": "-32 dBZ wispy green"},
    {"dbz": -12, "hex": "#6EE678", "rgba": [110, 230, 120, 90], "label": "-12 dBZ faint green"},
    {"dbz": 0, "hex": "#46D264", "rgba": [70, 210, 100, 130], "label": "0 dBZ light green"},
    {"dbz": 8, "hex": "#28D462", "rgba": [40, 212, 98, 180], "label": "8 dBZ green, partial alpha"},
    {"dbz": 15, "hex": "#109E44", "rgba": [16, 158, 68, 240], "label": "15 dBZ brighter than #08772E"},
    {"dbz": 20, "hex": "#0FA33D", "rgba": [15, 163, 61, 255], "label": "20 dBZ James green"},
    {"dbz": 25, "hex": "#32C94B", "rgba": [50, 201, 75, 255], "label": "25 dBZ James green"},
    {"dbz": 28, "hex": "#7DFF6A", "rgba": [125, 255, 106, 255], "label": "28 dBZ neon green"},
    {"dbz": 30, "hex": "#F4F20D", "rgba": [244, 242, 13, 255], "label": "30 dBZ James yellow"},
