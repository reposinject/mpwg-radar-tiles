# Copy to /etc/mpwg-radar.env on the EC2 host (or .env for local runs).
# Never commit real credentials.

# --- cooker region / zoom ---
# Named regions: conus (default, NOAA MRMS mosaic) or central-texas (smoke/dev).
# Aliases: REGION, BBOX (same meaning as MPWG_REGION / MPWG_BBOX).
MPWG_REGION=conus
# Optional override: west,south,east,north in degrees (replaces the named bbox).
# MPWG_BBOX=-130,20,-60,55
#
# CONUS candidate 512px XYZ tiles/frame (inclusive of empty tiles):
#   z5=35  z6=126  z7=442  z8=1734  z9=6600
# Default z6-8 = 2302 tiles/frame — fits t4g.small on the ~3 min timer with
# empty-tile skip. Do not set MPWG_MAX_ZOOM=9 on t4g.small (z6-9 = 8902).
# z5 is cheap (+35 tiles) if the map needs a national overview: MPWG_MIN_ZOOM=5.
MPWG_MODES=clean
# MPWG_MODES=clean,standard,all
MPWG_MIN_ZOOM=6
MPWG_MAX_ZOOM=8
MPWG_TILE_SIZE=512
MPWG_SKIP_EMPTY_TILES=true
MPWG_KEEP_DBZ=true
MPWG_DATA_DIR=/var/lib/mpwg-radar/data
MPWG_OUTPUT_DIR=/var/lib/mpwg-radar/output
MPWG_RETENTION_FRAMES=30
MPWG_LOG_LEVEL=INFO

# NOAA MRMS (self-hosted ingest; no paid radar vendor)
MRMS_LATEST_URL=https://mrms.ncep.noaa.gov/2D/MergedReflectivityQCComposite/MRMS_MergedReflectivityQCComposite.latest.grib2.gz
MRMS_S3_BUCKET=noaa-mrms-pds
MRMS_S3_PREFIX=CONUS/MergedReflectivityQCComposite_00.50
MRMS_TIMEOUT_SECONDS=60

# --- Cloudflare R2 (S3-compatible). Leave blank to cook locally without upload. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mpwg-radar
R2_ENDPOINT=
# If R2_ENDPOINT is empty, it is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PREFIX=radar
R2_PUBLIC_BASE_URL=
MPWG_UPLOAD=true
