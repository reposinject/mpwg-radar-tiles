+def _reclaim_enabled() -> bool:
+    """Local frame removal and R2 prefix deletion. Default off.
+
+    Unset, empty, and any value other than 1/true/yes/on stay off.
+    Playback length is separate and still follows retention_frames.
+    """
+    return os.environ.get("MPWG_RECLAIM", "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _pinned_frame_ids() -> set[str]:
+    """Optional one-transition ids that must remain in the playback manifest.
+
+    This does not keep every file on disk in the manifest, and it does not
+    delete anything. The launcher sets it for the first publish only.
+    """
+    raw = os.environ.get("MPWG_PIN_FRAME_IDS_FILE", "").strip()
+    if not raw:
+        return set()
+    path = Path(raw)
+    if not path.is_file():
+        log.warning("MPWG_PIN_FRAME_IDS_FILE missing path=%s", path)
+        return set()
+    ids: set[str] = set()
+    for line in path.read_text(encoding="utf-8").splitlines():
+        item = line.strip()
+        if item and not item.startswith("#"):
+            ids.add(item)
+    return ids
+
+
+def _with_pinned_frames(
+    frames: List[Dict],
+    mode_dir: Path,
+    product: ProductSpec,
+    mode: str,
+) -> List[Dict]:
+    """Union pinned composite ids into the bounded playback list."""
+    if product.id != "composite":
+        return frames
+    pins = _pinned_frame_ids()
+    if not pins:
+        return frames
+    have = {item.get("id") for item in frames}
+    missing = pins - have
+    if not missing:
+        return frames
+    catalog = {item["id"]: item for item in _list_frames(mode_dir, product, mode)}
+    merged = list(frames)
+    for frame_id in sorted(missing):
+        item = catalog.get(frame_id)
+        if item is None:
+            log.warning("pinned composite frame not on disk id=%s", frame_id)
+            continue
+        merged.append(item)
+    merged.sort(key=lambda item: item.get("valid_time") or "", reverse=True)
+    return merged
+
