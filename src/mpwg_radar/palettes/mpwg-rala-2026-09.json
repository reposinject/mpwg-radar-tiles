    {"dbz": 15, "hex": "#6CF860", "rgba": [108, 248, 96, 250], "label": "15 dBZ brighter envelope"},
    {"dbz": 23, "hex": "#76FC54", "rgba": [118, 252, 84, 255], "label": "23 dBZ vivid green"},
