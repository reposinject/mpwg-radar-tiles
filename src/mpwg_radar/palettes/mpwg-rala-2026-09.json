  "name": "MPWG RALA",
  "author": "James",
  "version": "2026-09-rala-p2",
  "description": "RALA Phase 2 display ramp. James Sep 2026 anchors from 15 dBZ up are unchanged and interpolated in RGB against actual dBZ (not 5 dBZ buckets). Below 15 the ramp continues in faint greens so weak and negative *valid* returns stay visible. display_min is -32, the physical floor of a valid dBZ sample. No-echo and missing/no-coverage stay transparent via the category mask — they are not mapped as 0 dBZ and there is no 10/15/20 dBZ blank. Composite production keeps mpwg-clean-2026-09 (display_min=15). Sub-15 stops are the RALA extension (not additional James anchors).",
  "units": "dBZ",
  "display_min_dbz": -32,
  "below_min": [0, 0, 0, 0],
  "stops": [
    {"dbz": -32, "hex": "#032010", "rgba": [3, 32, 16, 255], "label": "-32 dBZ faintest green (valid only)"},
